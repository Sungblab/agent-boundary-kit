{
  "inputMode": "native-payload-with-carrier",
  "nativePayload": {
    "session_id": "native-session-fixture",
    "transcript_path": "<claude-transcript-jsonl>",
    "cwd": "<repo-root>",
    "permission_mode": "default",
    "hook_event_name": "PostToolUse",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "src/mindmap/new-surface.ts",
      "content": "export const currentSurface = true;"
    },
    "tool_response": {
      "filePath": "src/mindmap/new-surface.ts",
      "success": true
    }
  },
  "metadataCarrier": {
    "carrierVersion": "abk-native-metadata-carrier/v1",
    "hookId": "post_edit_scope_check",
    "repoRoot": ".",
    "task": {
      "type": "replacement",
      "declaredBy": "metadata-carrier",
      "summary": "Replace a public surface and remove stale references from declared files."
    },
    "approvedScope": [
      "src/mindmap/**",
      "docs/**",
      "tests/**"
    ],
    "offLimits": [
      "src/auth/**",
      "src/billing/**"
    ],
    "namedTools": [
      "opendataloader-pdf",
      "latex"
    ],
    "staleTerms": [
      "legacy mind map",
      "old mindmap"
    ],
    "externalSources": [
      "evidence/issue.md",
      "evidence/log-summary.md"
    ],
    "metadataFiles": [
      "boundary.json"
    ]
  }
}
